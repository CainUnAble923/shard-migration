+function Send-AgentQuestions([switch]$Force) {
+    # cc-P216: this Golem's questions (Questions.ps1's card: the open ones in full, the last five closed with their
+    # answers), when they change or every 5 minutes, so the game PC's cards show them and can answer them.
+    $lib = Join-Path $Root 'Questions.ps1'
+    if (-not (Test-Path -LiteralPath $lib)) { return }
+    . $lib
+    $t = ([ordered]@{ golem = $Golem; questions = (Get-QuestionCard $Root $Golem) } | ConvertTo-Json -Depth 8 -Compress)
+    if (-not $Force -and $t -eq $script:LastQuestions -and ((Get-Date) - $script:LastQuestionsAt).TotalMinutes -lt 5) { return }
+    $null = Invoke-AgentApi 'POST' '/api/agent/questions' $t
+    $script:LastQuestions = $t; $script:LastQuestionsAt = Get-Date
+}
