+# cc-P216: Chase's answers to this Golem's questions about P<nn> that no session has been given yet, for the hand-off
+# (a retried STOPPED prompt, or a running one a new session carries on); each is marked delivered. '' when none.
+function Get-AnswerContext([string]$p) {
+    if (-not $p) { return '' }
+    $t = ''
+    foreach ($a in @(Get-PendingAnswers $Root (Get-QName) $p)) {
+        $t += Format-AnswerForSession $Root $a
+        if (-not $DryRun) { Set-AnswerDelivered $Root ([string]$a.id) $NowTime }
+        Log ('answer ' + [string]$a.id + ' handed to the session for ' + $p)
+    }
+    $t
+}
