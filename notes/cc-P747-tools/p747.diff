+# cc-P747: a review still unclaimed (its file still in queue\) after buildReviewFallbackMinutes goes to $golem (Iron) as its
+# next hand-off: Assign-Prompt.ps1 -Prompt <review> -Golem <golem> -RunNext, the overseer's own way. Returns what the record
+# keeps ('Iron'; 'claimed' when a Golem took it meanwhile; 'refused: <why>' when Assign-Prompt refused), '' to try again.
+function Invoke-BuildReviewFallback([string]$Root, [string]$PromptDir, $rec, [string]$golem, [double]$age) {
+    $file = [string](Get-GolemProp $rec 'reviewFile' '')
+    if (-not $file) { return '' }
+    if (-not (Test-Path -LiteralPath (Join-Path (Join-Path $PromptDir 'queue') $file))) { return 'claimed' }
+    $ap = Join-Path $PSScriptRoot 'Assign-Prompt.ps1'
+    if (-not (Test-Path -LiteralPath $ap)) { Write-GolemLog ("build review: $file unclaimed for " + [int]$age + " minutes, but there is no Assign-Prompt.ps1 beside Golems.ps1: not assigned"); return '' }
+    $eap = $ErrorActionPreference; $ErrorActionPreference = 'Continue'
+    $out = (& powershell.exe -NoProfile -ExecutionPolicy Bypass -File $ap -Prompt ([string]$rec.reviewPrompt) -Golem $golem -RunNext -Root $Root -PromptDir $PromptDir 2>&1 | Out-String).Trim()
+    $code = $LASTEXITCODE
+    $ErrorActionPreference = $eap
+    $last = (@($out -split "`r?`n" | Where-Object { $_.Trim() }) | Select-Object -Last 1)
+    if ($code -eq 0) {
+        Write-GolemLog ("build review: $file unclaimed for " + [int]$age + " minutes: assigned to $golem with Assign-Prompt.ps1 -RunNext (its next hand-off, in a fresh session)")
+        return $golem
+    }
+    Write-GolemLog ("build review: $file unclaimed for " + [int]$age + " minutes: Assign-Prompt.ps1 could not give it to $golem (exit $code): " + [string]$last)
+    if ($code -eq 2) { return ('refused: ' + [string]$last) }
+    ''
+}
