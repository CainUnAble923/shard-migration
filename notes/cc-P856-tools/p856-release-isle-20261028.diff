+// ClusterFWinterSetLayout.cs
+//
+// cc-P856: where New Haven's winter set stands, as rows of the winter decor (ClusterFWinterDecor places them with the
+// rest of the decor on December 1 and takes them down after January 6, by serial). Layer "addon": the row's piece is a
+// WinterSeasonAddon of the design DesignOf(key) names, standing with its own tile at X, Y, Z; ItemId is 0 (an addon has
+// no art of its own) and Name is the piece's name.
+//
+// RELEASE (isle) branch: the ML plaza's New Haven on the classic Trammel map (x 3400-3560). Each spot was found by
+// shard-migration notes/cc-P856-tools/rel/findrel.py: main's tests per tile on this map (reached on foot from the
+// square's start 3503,2574, standing z within 2, not protected by P266's list, not another winter row's tile, nothing
+// standing under a piece, nothing impassable in its outline) and the town's walk with the pieces in place. cc-P869 (the
+// build review P865): no tree and none of P678's winter rows within 3 tiles of any tile a piece covers
+// (notes/cc-P856-tools/keepclear.py); placed.md in notes/cc-P869-review lists every part.
+//
+//   the plaza's harbour  the Santa bench at the top of the boardwalk, the snowman bench and the large snow globe on the pier
+//   the west hill        the Christmas train on the open grass among the houses on the town's west side (it stood by
+//                        the east wall, beside a walnut tree and over a sapling, until cc-P869)
+//
+// The holiday fireplace has no row here either: no room in the Gentle Rest Inn fits it (notes, "Deviations").
+
+using System.Collections.Generic;
+
+namespace Server;
+
+public static class ClusterFWinterSetLayout
+{
+    public const string AddonLayer = "addon";
+
+    private static readonly Dictionary<string, string> _designs = new()
+    {
+        ["set-train"] = "christmas-train",
+        ["set-snowman-bench"] = "snowman-bench",
+        ["set-santa-bench"] = "santa-bench",
+        ["set-snow-globe"] = "large-snow-globe"
+    };
+
+    public static readonly ClusterFWinterDecorLayout.Row[] Rows =
+    {
+        new("set-train", "west", 3436, 2614, 43, 0, "a Christmas train", 0, "-", AddonLayer),
+        new("set-snowman-bench", "square", 3503, 2596, 1, 0, "a snowman bench", 0, "-", AddonLayer),
+        new("set-santa-bench", "square", 3505, 2589, 16, 0, "a Santa bench", 0, "-", AddonLayer),
+        new("set-snow-globe", "square", 3518, 2591, 1, 0, "a large snow globe", 0, "-", AddonLayer),
+    };
+
+    /// <summary>The design an addon row stands, or null for a key that is not one of these rows.</summary>
+    public static string DesignOf(string key) => key != null && _designs.TryGetValue(key, out var d) ? d : null;
+}
