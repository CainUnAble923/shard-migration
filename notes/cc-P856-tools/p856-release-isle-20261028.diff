@@ -0,0 +1,154 @@
+// WinterSetAddon.cs
+//
+// cc-P856 (P852 "port first" item 3): New Haven's winter set. Five pieces from the community, rebuilt as our own addons
+// from their component lists (WinterSetDesigns.cs, generated by shard-migration notes/cc-P856-tools/convert856.py; the
+// downloads in D:\UO\third-party\code were read for their numbers only, no code taken). Every piece is stock client art,
+// so no player package change. Notes: shard-migration notes/cc-P856-new-haven-winter-set.md.
+//
+//   christmas-train     Celestial            engine, fuel car and passenger car; wheels, smoke and lights animate
+//   large-snow-globe    Milva                a walk-round snow globe with moving snow
+//   santa-bench         Candy Apple          Santa between two benches under a garland, candy canes and lamps
+//   snowman-bench       Candy Apple          two benches, snowmen, poinsettias, a little tree
+//   holiday-fireplace   Lagatha, after Gwenivere (Knights of the Round Table shard)   stockings, garland, a bear rug
+//
+// P855's data addon (ShardDecorAddon) had not merged into main when this ran, so these are hand-written classes as the
+// prompt allows: one addon type that builds any of the five, a deed for the house version (the Festival's winter stock
+// sells the benches and the fireplace), and a seasonal version the winter decor seeder places and takes down by serial
+// (WinterSeasonAddon, ClusterFWinterSetLayout).
+
+using System.Collections.Generic;
+using ModernUO.Serialization;
+
+namespace Server.Items
+{
+    /// <summary>One piece of a design: art, offset from the addon's tile, hue, light (or null) and name (or null).</summary>
+    public sealed record WinterSetPart(int ItemID, int X, int Y, int Z, int Hue, LightType? Light, string Name);
+
+    /// <summary>A whole piece: its key, name, author and parts.</summary>
+    public sealed record WinterSetDesign(string Key, string Name, string Credit, IReadOnlyList<WinterSetPart> Parts);
+
+    /// <summary>A part of a winter set addon: stock art, with the design's author on it.</summary>
+    [SerializationGenerator(0, false)]
+    public partial class WinterSetComponent : AddonComponent
+    {
+        public WinterSetComponent(int itemID) : base(itemID)
+        {
+        }
+
+        public override void GetProperties(IPropertyList list)
+        {
+            base.GetProperties(list);
+            if (Addon is WinterSetAddon addon && WinterSetDesigns.All.TryGetValue(addon.Design ?? "", out var d))
+            {
+                list.Add($"Design by {d.Credit}");
+            }
+        }
+    }
+
+    /// <summary>One of the winter set's pieces as a house addon (from its deed).</summary>
+    [SerializationGenerator(0, false)]
+    public partial class WinterSetAddon : BaseAddon
+    {
+        [SerializableField(0, setter: "private")]
+        [SerializedCommandProperty(AccessLevel.GameMaster, readOnly: true)]
+        private string _design;
+
+        [Constructible(AccessLevel.GameMaster)]
+        public WinterSetAddon(string design)
+        {
+            _design = design;
+            if (!WinterSetDesigns.All.TryGetValue(design ?? "", out var d))
+            {
+                return;
+            }
+
+            Name = d.Name;
+            foreach (var part in d.Parts)
+            {
+                var c = new WinterSetComponent(part.ItemID);
+                if (part.Hue != 0)
+                {
+                    c.Hue = part.Hue;
+                }
+
+                if (part.Light is { } light)
+                {
+                    c.Light = light;
+                }
+
+                if (part.Name != null)
+                {
+                    c.Name = part.Name;
+                }
+
+                AddComponent(c, part.X, part.Y, part.Z);
+            }
+        }
+
+        // Each part keeps its design's hue.
+        public override bool ShareHue => false;
+
+        public override BaseAddonDeed Deed => new WinterSetDeed(_design);
+    }
+
+    /// <summary>The deed for a house copy of one winter set piece.</summary>
+    [SerializationGenerator(0, false)]
+    public partial class WinterSetDeed : BaseAddonDeed
+    {
+        [SerializableField(0, setter: "private")]
+        [SerializedCommandProperty(AccessLevel.GameMaster, readOnly: true)]
+        private string _design;
+
+        [Constructible(AccessLevel.GameMaster)]
+        public WinterSetDeed(string design)
+        {
+            _design = design;
+            Name = WinterSetDesigns.All.TryGetValue(design ?? "", out var d) ? $"a deed for {d.Name}" : "a deed for winter decor";
+        }
+
+        public override BaseAddon Addon => new WinterSetAddon(_design);
+
+        public override void GetProperties(IPropertyList list)
+        {
+            base.GetProperties(list);
+            if (WinterSetDesigns.All.TryGetValue(_design ?? "", out var d))
+            {
+                list.Add($"Design by {d.Credit}");
+            }
+
+            list.Add("House decor");
+        }
+
+        public override void OnDoubleClick(Mobile from)
+        {
+            if (!WinterSetDesigns.All.ContainsKey(_design ?? ""))
+            {
+                from.SendMessage(0x22, "This deed's design cannot be found. Please page a staff member.");
+                return;
+            }
+
+            base.OnDoubleClick(from);
+        }
+    }
+
+    /// <summary>
+    /// A winter set piece the New Haven winter decor placed (ClusterFWinterSetLayout's row, by its key). Tracked by
+    /// serial with the rest of the decor and taken down with it; no deed, not constructible.
+    /// </summary>
+    [SerializationGenerator(0, false)]
+    public partial class WinterSeasonAddon : WinterSetAddon, IWinterDecorItem
+    {
+        [SerializableField(0)]
+        [SerializedCommandProperty(AccessLevel.GameMaster, readOnly: true)]
+        private string _key;
+
+        public WinterSeasonAddon(ClusterFWinterDecorLayout.Row row) : base(ClusterFWinterSetLayout.DesignOf(row.Key))
+        {
+            _key = row.Key;
+        }
+
+        public override BaseAddonDeed Deed => null;
+
+        public override bool Decays => false;
+    }
+}
