+                yield return R(g, "bonsai", "Bonsai tree (decor)", 600, 3, 0x28DC, 0, RewardStore.One(() => new RewardDecor(0x28DC, "a bonsai tree")));
+                yield return R(g, "bandages", "Bandages (100)", 50, 0, 0xE21, 0, RewardStore.Stack<Bandage>(100));
+                break;
+            case "keepers":
