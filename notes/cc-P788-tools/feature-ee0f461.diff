+                yield return R(g, "necroreagents", "Bag of necromancer reagents (50 each)", 150, 1, 0xE76, 0, RewardStore.One(() => new BagOfNecroReagents()));
+                yield return R(g, "candles", "Candles (5)", 50, 0, 0xA28, 0, Bundle<Candle>("a bag of candles", 5));
