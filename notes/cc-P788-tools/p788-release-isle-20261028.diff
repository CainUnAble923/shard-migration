+// cc-P760: the reward stores' shared core. Notes: shard-migration notes/cc-P760-reward-stores.md; the plan Chase approved
+// (2026-11-01) is notes/cc-P760-stores-plan.md.
+//
+// Every store is built on the League shop's pattern (LeagueShop/, cc-P229):
+//   - rows: what a row is, what opens it, its price, what it hands over (RewardStoreRow);
+//   - one window: the League shop's scroll frame, five rows a page, the art greyed until the row opens (RewardStoreGump);
+//   - a confirm step, then a server-side buy that checks everything again, hands the items over all or none, and then
+//     takes exactly the price (RewardStore.Purchase);
+//   - spending never touches a lifetime total: each currency (IRewardCurrency) spends a balance only.
+//
+// The stores: the guild stores (GuildStores.cs), the Festival store (FestivalStore.cs) and the Achievement store
+// (AchievementStore.cs). The League shop keeps its own code and its own tests (it gained rows in LeagueShop.cs).
+//
+// Prices are placeholders, every one in one table: Configuration/reward-stores.json (RewardStorePrices), a row's price
+// and what opens it by the row's key. A missing file is written with the built-in defaults; a bad file is refused whole.
+//
+// Guardrails (F-12, F-13), for every store, checked by RewardStoreVerification over every row: nothing grants skill or stat
+// points; no power scrolls, bless deeds, or artifacts or gear with item properties; art only from registry.csv.
+
+#nullable enable
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Server.Engines.LeagueRewards;
+using Server.Items;
+using Server.Mobiles;
+
+namespace Server.Engines.RewardStores;
+
+public enum RewardStoreResult
+{
+    Bought,
+    NoAccount,
+    Unavailable,
+    Locked,
+    AlreadyOwned,
+    NotEnough,
+    NoRoom
+}
+
+/// <summary>A balance a store spends. Spending takes from the balance only, never from a lifetime total.</summary>
+public interface IRewardCurrency
+{
+    string Name { get; }
+
+    int Balance(PlayerMobile pm);
+
+    /// <summary>Takes exactly <paramref name="amount"/>. False, and nothing taken, when the balance is short.</summary>
+    bool TrySpend(PlayerMobile pm, int amount);
+}
+
+/// <summary>One store row: what it is, what opens it, its price, and what it hands over.</summary>
+public sealed class RewardStoreRow
+{
+    public RewardStoreRow(string key, string label, int price, int opensAt, int itemID, int hue = 0,
+        Func<PlayerMobile, List<Item>>? create = null, string? titleKey = null)
+    {
+        Key = key;
+        Label = label;
+        DefaultPrice = price;
+        DefaultOpensAt = opensAt;
+        ItemID = itemID;
+        Hue = hue;
+        Create = create;
+        TitleKey = titleKey;
+    }
+
+    public string Key { get; }
+    public string Label { get; }
+    public int DefaultPrice { get; }
+    public int DefaultOpensAt { get; }
+    public int ItemID { get; }
+    public int Hue { get; }
+
+    /// <summary>The items handed over, made for this buyer now. Null for a title.</summary>
+    public Func<PlayerMobile, List<Item>>? Create { get; }
+
+    /// <summary>The LeagueTitles key a title row grants (account-wide, chosen in the Titles window). Null for items.</summary>
+    public string? TitleKey { get; }
+
+    /// <summary>An extra condition besides OpensAt (the Achievement store's "every Discovery achievement"), and its words.</summary>
+    public Func<PlayerMobile, bool>? Condition { get; init; }
+
+    public string? ConditionText { get; init; }
+
+    public bool IsTitle => TitleKey != null;
+
+    /// <summary>The price in force: the price table's, else the default.</summary>
+    public int Price => RewardStorePrices.Current.PriceOf(this);
+
+    /// <summary>What opens the row (a rank index, an AP total, 0 for open to all), from the price table.</summary>
+    public int OpensAt => RewardStorePrices.Current.OpensAtOf(this);
+}
+
+/// <summary>A store: its name, its currency, its rows and what opens a row.</summary>
+public abstract class RewardStoreDef
+{
+    public abstract string Key { get; }
+
+    public abstract string Title { get; }
+
+    /// <summary>One line under the balance, about the store.</summary>
+    public abstract string Blurb { get; }
+
+    public abstract IRewardCurrency Currency { get; }
+
+    /// <summary>The rows on sale now.</summary>
+    public abstract IReadOnlyList<RewardStoreRow> Rows();
+
+    /// <summary>Every row the store can ever sell (the price table lists each), whatever is on sale now.</summary>
+    public virtual IReadOnlyList<RewardStoreRow> AllRows() => Rows();
+
+    /// <summary>The buyer's measure against a row's OpensAt: a rank index, an AP total.</summary>
+    public abstract int Progress(PlayerMobile pm);
+
+    /// <summary>How a locked row reads: "Requires Master rank", "Requires 500 AP".</summary>
+    public abstract string OpensText(int opensAt);
+
+    /// <summary>The measure's name and the buyer's value, for the window's header ("Rank: Journeyman").</summary>
+    public abstract string ProgressText(PlayerMobile pm);
+
+    /// <summary>The confirm step's last line: what spending never lowers.</summary>
+    public abstract string SpendNote { get; }
+
+    /// <summary>Whether the buyer may shop here now (at the guildmaster, beside the peddler, in season).</summary>
+    public virtual bool CanShop(PlayerMobile pm, out string why)
+    {
+        why = "";
+        return true;
+    }
+
+    /// <summary>The row on sale now with this key, or null.</summary>
+    public RewardStoreRow? Find(string key) => Rows().FirstOrDefault(r => r.Key == key);
+
+    /// <summary>A fresh copy of this store for a reopened window (the stores carry their guildmaster or peddler).</summary>
+    public virtual RewardStoreDef Refresh() => this;
+}
+
+public static class RewardStore
+{
+    public static ClusterFAccountData? DataOf(Mobile m) => LeagueShop.DataOf(m);
+
+    public static bool IsUnlocked(PlayerMobile pm, RewardStoreDef store, RewardStoreRow row) =>
+        store.Progress(pm) >= row.OpensAt && (row.Condition?.Invoke(pm) ?? true);
+
+    public static bool IsOwned(PlayerMobile pm, RewardStoreRow row) =>
+        row.TitleKey != null && DataOf(pm) is { } data && data.LeagueTitles.Owned.Contains(row.TitleKey);
+
+    /// <summary>Why this buyer cannot buy the row now, or Bought when they can. Opens, then ownership, then the price.</summary>
+    public static RewardStoreResult Check(PlayerMobile pm, RewardStoreDef store, RewardStoreRow row)
+    {
+        if (DataOf(pm) == null)
+        {
+            return RewardStoreResult.NoAccount;
+        }
+
+        if (store.Find(row.Key) == null)
+        {
+            return RewardStoreResult.Unavailable;
+        }
+
+        if (!IsUnlocked(pm, store, row))
+        {
+            return RewardStoreResult.Locked;
+        }
+
+        if (IsOwned(pm, row))
+        {
+            return RewardStoreResult.AlreadyOwned;
+        }
+
+        return store.Currency.Balance(pm) < row.Price ? RewardStoreResult.NotEnough : RewardStoreResult.Bought;
+    }
+
+    /// <summary>
+    /// Buys the row: every check again, server side, then the items into the pack (all or none), then exactly the price.
+    /// Nothing is taken on a refusal, and a failed spend takes the items back.
+    /// </summary>
+    public static RewardStoreResult Purchase(PlayerMobile pm, RewardStoreDef store, RewardStoreRow row)
+    {
+        if (!store.CanShop(pm, out var why))
+        {
+            pm.SendMessage(0x22, why);
+            return RewardStoreResult.Unavailable;
+        }
+
+        // The row as the store sells it now: a stale window (the season changed, the row left) buys nothing.
+        var current = store.Find(row.Key);
+        var check = current == null ? RewardStoreResult.Unavailable : Check(pm, store, current);
+        if (check != RewardStoreResult.Bought)
+        {
+            pm.SendMessage(0x22, RefusalLine(check, pm, store, current ?? row));
+            return check;
+        }
+
+        row = current!;
+        var data = DataOf(pm)!;
+        var price = row.Price;
+
+        if (row.IsTitle)
+        {
+            if (!store.Currency.TrySpend(pm, price))
+            {
+                pm.SendMessage(0x22, RefusalLine(RewardStoreResult.NotEnough, pm, store, row));
+                return RewardStoreResult.NotEnough;
+            }
+
+            data.LeagueTitles.Owned.Add(row.TitleKey!);
+            pm.SendMessage(0x44, $"System: Title unlocked: \"{LeagueTitles.Display(row.TitleKey!)}\". Choose it in Titles.");
+            pm.PlaySound(0x5A7);
+            return RewardStoreResult.Bought;
+        }
+
+        var items = row.Create!(pm);
+        var pack = pm.Backpack;
+        if (pack == null || items.Count == 0 || !CanHoldAll(pm, pack, items))
+        {
+            DeleteAll(items);
+            pm.SendLocalizedMessage(1074361); // The reward could not be given.  Make sure you have room in your pack.
+            return RewardStoreResult.NoRoom;
+        }
+
+        if (!store.Currency.TrySpend(pm, price))
+        {
+            DeleteAll(items);
+            pm.SendMessage(0x22, RefusalLine(RewardStoreResult.NotEnough, pm, store, row));
+            return RewardStoreResult.NotEnough;
+        }
+
+        foreach (var item in items)
+        {
+            pack.DropItem(item);
+            item.InvalidateProperties();
+        }
+
+        pm.SendLocalizedMessage(1073621); // Your reward has been placed in your backpack.
+        pm.PlaySound(0x5A7);
+        return RewardStoreResult.Bought;
+    }
+
+    public static string RefusalLine(RewardStoreResult result, PlayerMobile pm, RewardStoreDef store, RewardStoreRow row) =>
+        result switch
+        {
+            RewardStoreResult.NoAccount    => "You have no account record.",
+            RewardStoreResult.Unavailable  => "That is no longer for sale here.",
+            RewardStoreResult.Locked       => row.Condition != null && !row.Condition(pm) && row.ConditionText != null
+                ? row.ConditionText
+                : store.OpensText(row.OpensAt),
+            RewardStoreResult.AlreadyOwned => "You already hold that title.",
+            RewardStoreResult.NotEnough    =>
+                $"That costs {row.Price:N0} {store.Currency.Name} (you have {store.Currency.Balance(pm):N0}).",
+            RewardStoreResult.NoRoom       => "Make room in your pack first.",
+            _                              => ""
+        };
+
+    // CleanUpBritanniaRewards.CanHoldAll, as LeagueShop: several items, checked together before any is given.
+    public static bool CanHoldAll(PlayerMobile pm, Container pack, List<Item> items)
+    {
+        var weight = items.Sum(i => i.TotalWeight + i.PileWeight);
+        return pack.CheckHold(pm, items[0], false, true, items.Count - 1, weight - items[0].TotalWeight - items[0].PileWeight);
+    }
+
+    private static void DeleteAll(List<Item> items)
+    {
+        foreach (var item in items)
+        {
+            item.Delete();
+        }
+    }
+
+    // -- Helpers the stock tables use --
+
+    public static Func<PlayerMobile, List<Item>> One(Func<Item> make) => _ => [make()];
+
+    public static Func<PlayerMobile, List<Item>> One(Func<PlayerMobile, Item> make) => pm => [make(pm)];
+
+    /// <summary>A stack of a stackable item (Amount), or the item alone.</summary>
+    public static Func<PlayerMobile, List<Item>> Stack<T>(int amount) where T : Item =>
+        _ =>
+        {
+            // Loot.Construct: most stock resources have only an optional-amount constructor (no new()).
+            var item = Loot.Construct<T>(typeof(T));
+            if (item.Stackable)
+            {
+                item.Amount = amount;
+            }
+
+            return [item];
+        };
+
+    /// <summary>A tool with this many uses (pinned BaseTool.UsesRemaining), or the item alone.</summary>
+    public static Func<PlayerMobile, List<Item>> Tool<T>(int uses) where T : Item =>
+        _ =>
+        {
+            var item = Loot.Construct<T>(typeof(T));
+            if (item is IUsesRemaining tool)
+            {
+                tool.UsesRemaining = uses;
+            }
+
+            return [item];
+        };
+
+    /// <summary>Several of a non-stacking item in one bag.</summary>
+    public static Func<PlayerMobile, List<Item>> Bagged<T>(string bagName, int count) where T : Item =>
+        _ =>
+        {
+            var bag = new Bag { Name = bagName };
+            for (var i = 0; i < count; i++)
+            {
+                bag.DropItem(Loot.Construct<T>(typeof(T)));
+            }
+
+            return [bag];
+        };
+}
diff --git a/server/customizations/RewardStores/RewardStoreCommands.cs b/server/customizations/RewardStores/RewardStoreCommands.cs
new file mode 100644
index 0000000..ace766b
--- /dev/null
+++ b/server/customizations/RewardStores/RewardStoreCommands.cs
@@ -0,0 +1,126 @@
+// cc-P760: the reward stores' commands. Players: [apstore opens the Achievement store and [leagueshop the League shop, from
+// anywhere; [guildstore opens the Guild Store of your guild whose guildmaster is beside you (the same windows the achievements window and the League Registrar open). Staff, for testing:
+// [RewardStores grant <character name> <tokens|ap|guild:<key>> <amount> (a guild grant also joins the character and sets
+// its standing to the amount, so its rows open).
+
+#nullable enable
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Server.Accounting;
+using Server.Commands;
+using Server.Engines.LeagueRewards;
+using Server.Gumps;
+using Server.Mobiles;
+
+namespace Server.Engines.RewardStores;
+
+public static class RewardStoreCommands
+{
+    public static void Configure()
+    {
+        CommandSystem.Register("apstore", AccessLevel.Player, OnApStore);
+        CommandSystem.Register("leagueshop", AccessLevel.Player, OnLeagueShop);
+        CommandSystem.Register("guildstore", AccessLevel.Player, OnGuildStore);
+    }
+
+    [Usage("guildstore")]
+    [Description("Opens the Guild Store of a guild you belong to whose guildmaster is beside you (the same store as the guild window's Guild Store button).")]
+    [ShardCommand(CommandCategory.Player, Shard = CommandShard.Any)]
+    private static void OnGuildStore(CommandEventArgs e)
+    {
+        if (e.Mobile is not PlayerMobile pm)
+        {
+            return;
+        }
+
+        ClusterFGuildSystem.EnsureRegistered();
+        foreach (var def in ClusterFGuildSystem.AllGuilds.Values)
+        {
+            if (ClusterFGuildSystem.IsJoined(pm, def.Key) && ClusterFGuildSystem.FindGuildmasterNear(pm, def) is { } gm)
+            {
+                GuildStores.Open(pm, def.Key, gm);
+                return;
+            }
+        }
+
+        // Say what was found, so a player (or staff) can tell which half is missing.
+        var joined = ClusterFAccountPersistence.GetGuild(pm)?.JoinedGuilds.ToList() ?? [];
+        var near = ClusterFGuildSystem.AllGuilds.Values.Where(d => ClusterFGuildSystem.FindGuildmasterNear(pm, d) != null)
+            .Select(d => d.Name).ToList();
+        pm.SendMessage(0x22, "Stand beside the guildmaster of a guild you belong to. " +
+            $"Your guilds: {(joined.Count > 0 ? string.Join(", ", joined.Select(k => ClusterFGuildSystem.GetDef(k)?.Name ?? k)) : "none")}. " +
+            $"Guildmasters here: {(near.Count > 0 ? string.Join(", ", near) : "none")}.");
+    }
+
+    [Usage("apstore")]
+    [Description("Opens the Achievement store: spend achievement points on titles, cosmetics and decor. Your AP total never goes down.")]
+    [ShardCommand(CommandCategory.Player, Shard = CommandShard.Any)]
+    private static void OnApStore(CommandEventArgs e)
+    {
+        if (e.Mobile is PlayerMobile pm)
+        {
+            AchievementStoreDef.Open(pm);
+        }
+    }
+
+    [Usage("leagueshop")]
+    [Description("Opens the League shop: AP opens a row, Renown buys it.")]
+    [ShardCommand(CommandCategory.Player, Shard = CommandShard.Any)]
+    private static void OnLeagueShop(CommandEventArgs e)
+    {
+        if (e.Mobile is PlayerMobile pm)
+        {
+            pm.SendGump(new LeagueShopGump(pm));
+        }
+    }
+
+    public static List<string> Grant(string[] args)
+    {
+        if (args.Length < 4 || !int.TryParse(args[^1], out var amount))
+        {
+            return ["Usage: [RewardStores grant <character name> <tokens|ap|guild:<key>> <amount>"];
+        }
+
+        var what = args[^2].ToLowerInvariant();
+        var name = string.Join(' ', args[1..^2]);
+        var pm = World.Mobiles.Values.OfType<PlayerMobile>().FirstOrDefault(m => m.Name == name);
+        if (pm?.Account is not IAccount acct)
+        {
+            return [$"No character called '{name}'."];
+        }
+
+        var data = ClusterFAccountPersistence.GetOrCreate(acct);
+        switch (what)
+        {
+            case "tokens":
+                ClusterFAchievementSystem.AddToCounter(acct.Username, FestivalTokens.EarnedCounter, amount);
+                return [$"{name}: +{amount} Festival Tokens ({FestivalTokens.BalanceOf(acct.Username)})."];
+            case "ap":
+                data.AchievementPoints += amount;
+                LeagueTitles.Sync(data);
+                return [$"{name}: +{amount} AP ({data.AchievementPoints} total)."];
+            case "renown":
+                data.Renown += amount;
+                return [$"{name}: +{amount} Renown (balance only)."];
+        }
+
+        if (what.StartsWith("guild:", StringComparison.Ordinal))
+        {
+            var key = what[6..];
+            if (ClusterFGuildSystem.GetDef(key) == null)
+            {
+                return [$"No guild '{key}'."];
+            }
+
+            var guild = data.GetOrCreateGuildData(pm.Serial);
+            guild.JoinedGuilds.Add(key);
+            guild.GuildReputation[key] = Math.Max(guild.GetReputation(key), amount);
+            guild.AddCurrency(key, amount);
+            return [$"{name}: joined {key}, standing {guild.GetReputation(key)}, +{amount} {MuleUpgrades.CurrencyName(key)}."];
+        }
+
+        return [$"Unknown: '{what}'. tokens, ap, renown or guild:<key>."];
+    }
+}
diff --git a/server/customizations/RewardStores/RewardStoreGumps.cs b/server/customizations/RewardStores/RewardStoreGumps.cs
new file mode 100644
index 0000000..c2b8d6b
--- /dev/null
+++ b/server/customizations/RewardStores/RewardStoreGumps.cs
@@ -0,0 +1,264 @@
+// cc-P760: the reward stores' window and confirm step, the League shop's own (LeagueShopGumps.cs) for every store, so the
+// shard's stores look and work alike:
+//
+// RewardStoreGump         CleanUpBritanniaRewardGump's scroll frame, five rows a page, the item art greyed until the row
+//                         opens. Each row shows its price in the store's currency and what opens it, in cc-P169's
+//                         requirement colours (RequirementStyle): green when met, red when not. A Titles button opens the
+//                         League title picker, where a bought title is chosen.
+// RewardStoreConfirmGump  the confirm step: the row's requirements as a cc-P169 RequirementList, then Buy.
+//
+// Every press checks again server side (RewardStore.Purchase), so a stale page buys nothing.
+
+#nullable enable
+
+using System;
+using System.Collections.Generic;
+using Server.Engines.LeagueRewards;
+using Server.Gumps;
+using Server.Mobiles;
+using Server.Network;
+
+namespace Server.Engines.RewardStores;
+
+public class RewardStoreGump : Gump
+{
+    public const int RowHeight = LeagueShopGump.RowHeight;
+    public const int RowsPerPage = LeagueShopGump.RowsPerPage;
+    public const int BtnTitles = 2;
+    public const int BtnRowBase = 200;
+
+    public RewardStoreDef Store { get; }
+
+    public IReadOnlyList<RewardStoreRow> Rows { get; }
+
+    public RewardStoreGump(PlayerMobile pm, RewardStoreDef store) : base(50, 50)
+    {
+        pm.CloseGump<RewardStoreGump>();
+
+        Store = store;
+        Rows = store.Rows();
+
+        Closable = true;
+        Disposable = true;
+        Draggable = true;
+        Resizable = false;
+
+        AddPage(0);
+
+        AddImage(0, 0, 0x1F40);
+        AddImageTiled(20, 37, 300, 308, 0x1F42);
+        AddImage(20, 325, 0x1F43);
+        AddImage(35, 8, 0x39);
+        AddImageTiled(65, 8, 257, 10, 0x3A);
+        AddImage(290, 8, 0x3B);
+        AddImage(32, 33, 0x2635);
+        AddImageTiled(70, 55, 230, 2, 0x23C5);
+
+        // Dark text on the scroll, as the League shop.
+        AddLabel(70, 35, 0, store.Title);
+        AddLabel(40, 62, 0, $"{store.Currency.Name}:");
+        AddLabel(40, 78, 0x64, store.Currency.Balance(pm).ToString("N0"));
+        AddLabel(180, 62, 0, "You:");
+        AddLabel(180, 78, 0x64, store.ProgressText(pm));
+        AddImageTiled(35, 98, 270, 2, 0x23C5);
+        AddLabel(35, 101, 0, store.Blurb);
+
+        AddButton(35, 337, 4011, 4012, BtnTitles);
+        AddLabel(69, 337, 0, "Titles");
+
+        if (Rows.Count == 0)
+        {
+            AddLabel(35, 130, 0, "Nothing is on sale here now.");
+        }
+
+        var pages = Math.Max(1, (Rows.Count + RowsPerPage - 1) / RowsPerPage);
+
+        for (var page = 0; page < pages; page++)
+        {
+            AddPage(page + 1);
+
+            var offset = 122;
+
+            for (var i = page * RowsPerPage; i < Math.Min(Rows.Count, (page + 1) * RowsPerPage); i++)
+            {
+                var entry = Rows[i];
+                var row = Row.Of(pm, store, entry);
+
+                if (row.CanBuy)
+                {
+                    AddButton(35, offset + RowHeight / 2 - 5, 0x837, 0x838, BtnRowBase + i);
+                }
+
+                AddItem(55, offset + 4, entry.ItemID, row.Unlocked ? entry.Hue : LeagueShopGump.LockedArtHue);
+                AddLabel(110, offset + 2, row.Unlocked ? 0 : RequirementStyle.DisabledHue, entry.Label);
+                AddLabel(110, offset + 20, row.PriceHue, $"{entry.Price:N0} {store.Currency.Name}");
+                AddLabel(230, offset + 20, row.OpensHue, row.OpensText);
+
+                offset += RowHeight;
+            }
+
+            if (page > 0)
+            {
+                AddButton(150, 335, 0x15E3, 0x15E7, 0, GumpButtonType.Page, page);
+                AddHtmlLocalized(170, 335, 60, 20, 1074880, 0x1); // Previous
+            }
+
+            if (page < pages - 1)
+            {
+                AddButton(300, 335, 0x15E1, 0x15E5, 0, GumpButtonType.Page, page + 2);
+                AddHtmlLocalized(240, 335, 60, 20, 1072854, 0x1); // <div align=right>Next</div>
+            }
+        }
+    }
+
+    /// <summary>How one row draws for this buyer: open or locked, the price's and the opening's words and colours.</summary>
+    public readonly record struct Row(bool Unlocked, bool Owned, bool CanBuy, int PriceHue, string OpensText, int OpensHue)
+    {
+        public static Row Of(PlayerMobile pm, RewardStoreDef store, RewardStoreRow entry)
+        {
+            var unlocked = RewardStore.IsUnlocked(pm, store, entry);
+                var owned = RewardStore.IsOwned(pm, entry);
+            var affordable = store.Currency.Balance(pm) >= entry.Price;
+
+            var opensText = owned ? "Owned"
+                : !unlocked ? (entry.Condition != null && !entry.Condition(pm) && entry.ConditionText != null
+                    ? entry.ConditionText
+                    : store.OpensText(entry.OpensAt))
+                : "Open";
+            var opensHue = unlocked ? RequirementStyle.MetHue : RequirementStyle.NotMetHue;
+            var priceHue = !unlocked || owned ? RequirementStyle.DisabledHue
+                : affordable ? RequirementStyle.MetHue : RequirementStyle.NotMetHue;
+
+            return new Row(unlocked, owned, unlocked && !owned && affordable, priceHue, opensText, opensHue);
+        }
+    }
+
+    public override void OnResponse(NetState state, in RelayInfo info)
+    {
+        if (state.Mobile is not PlayerMobile pm)
+        {
+            return;
+        }
+
+        if (info.ButtonID == BtnTitles)
+        {
+            pm.SendGump(new LeagueTitleGump(pm));
+            return;
+        }
+
+        var index = info.ButtonID - BtnRowBase;
+        if (index < 0 || index >= Rows.Count)
+        {
+            return;
+        }
+
+        var store = Store.Refresh();
+        if (!store.CanShop(pm, out var why))
+        {
+            pm.SendMessage(0x22, why);
+            return;
+        }
+
+        // The row by its key, as the store sells it now: the confirm step and the purchase check everything again.
+        if (store.Find(Rows[index].Key) is { } row)
+        {
+            pm.SendGump(new RewardStoreConfirmGump(pm, store, row));
+        }
+        else
+        {
+            pm.SendMessage(0x22, "That is no longer for sale here.");
+            pm.SendGump(new RewardStoreGump(pm, store));
+        }
+    }
+}
+
+public class RewardStoreConfirmGump : GuildStyledGump
+{
+    public const int BtnBuy = 1;
+    public const int BtnBack = 2;
+
+    private const int W = 400;
+    private const int H = 240;
+
+    public RewardStoreDef Store { get; }
+
+    public RewardStoreRow Entry { get; }
+
+    public RequirementList Requirements { get; }
+
+    public RewardStoreConfirmGump(PlayerMobile pm, RewardStoreDef store, RewardStoreRow entry) : base(80, 80)
+    {
+        pm.CloseGump<RewardStoreConfirmGump>();
+        Store = store;
+        Entry = entry;
+
+        Closable = true;
+        Disposable = true;
+
+        var opensMet = store.Progress(pm) >= entry.OpensAt;
+
+        Requirements = new RequirementList()
+            .Check(opensMet, entry.OpensAt > 0 ? store.OpensText(entry.OpensAt).Replace("Requires", "Has") : "Open to all",
+                store.OpensText(entry.OpensAt));
+
+        if (entry.Condition != null)
+        {
+            var met = entry.Condition(pm);
+            Requirements.Check(met, (entry.ConditionText ?? "").Replace("Requires", "Has"), entry.ConditionText ?? "Not yet");
+        }
+
+        Requirements.Amount(store.Currency.Name, store.Currency.Balance(pm), entry.Price);
+
+        if (entry.IsTitle)
+        {
+            Requirements.Check(!RewardStore.IsOwned(pm, entry), "Title not yet held", "You already hold this title");
+        }
+
+        Requirements.Info(store.SpendNote);
+
+        AddBackground(0, 0, W, H, 9270);
+        RequirementStyle.AddSolidPanel(this, W, H);
+
+        AddLabel(20, 16, RequirementStyle.HeadingHue, $"Buy from {store.Title}?");
+        AddItem(20, 44, entry.ItemID, entry.Hue);
+        AddLabel(80, 46, 0x481, entry.Label);
+        AddLabel(80, 64, RequirementStyle.InfoHue, $"Price: {entry.Price:N0} {store.Currency.Name}");
+
+        var y = Requirements.Draw(this, 20, 92);
+        Requirements.DrawFooter(this, 20, y + 4, BtnBuy, $"Buy for {entry.Price:N0} {store.Currency.Name}");
+
+        AddButton(W - 90, H - 34, 4014, 4015, BtnBack);
+        AddLabel(W - 56, H - 32, RequirementStyle.InfoHue, "Back");
+
+    }
+
+    public override void OnResponse(NetState state, in RelayInfo info)
+    {
+        if (state.Mobile is not PlayerMobile pm)
+        {
+            return;
+        }
+
+        if (info.ButtonID == BtnBuy)
+        {
+            var store = Store.Refresh();
+            RewardStore.Purchase(pm, store, Entry);
+            if (store.CanShop(pm, out _))
+            {
+                pm.SendGump(new RewardStoreGump(pm, store));
+            }
+        }
+        else if (info.ButtonID == BtnBack)
+        {
+            var store = Store.Refresh();
+            if (store.CanShop(pm, out var why))
+            {
+                pm.SendGump(new RewardStoreGump(pm, store));
+            }
+            else
+            {
+                pm.SendMessage(0x22, why);
+            }
+        }
+    }
+}
diff --git a/server/customizations/RewardStores/RewardStoreItems.cs b/server/customizations/RewardStores/RewardStoreItems.cs
new file mode 100644
index 0000000..9668cad
--- /dev/null
+++ b/server/customizations/RewardStores/RewardStoreItems.cs
@@ -0,0 +1,31 @@
+// cc-P760: the reward stores' one item of their own, RewardDecor: house decor drawn from registered art (registry.csv) or
+// stock art. It is plain decor: no item properties, nothing on use, movable so it can be locked down in a house. The art's
+// tiledata on the server comes from the set that registered it (GuildHallDecorArt, ClusterFCommunityArtRecords), which
+// gives these pieces a weight of 255 (immovable); RewardDecor's own weight makes them carryable.
+
+using ModernUO.Serialization;
+
+namespace Server.Items;
+
+[SerializationGenerator(0, false)]
+public partial class RewardDecor : Item
+{
+    [Constructible]
+    public RewardDecor() : this(0x14F0, "a piece of decor")
+    {
+    }
+
+    public RewardDecor(int itemID, string name, int hue = 0) : base(itemID)
+    {
+        Name = name;
+        Hue = hue;
+    }
+
+    public override double DefaultWeight => 5.0;
+
+    public override void GetProperties(IPropertyList list)
+    {
+        base.GetProperties(list);
+        list.Add("House decor");
+    }
+}
diff --git a/server/customizations/RewardStores/RewardStorePrices.cs b/server/customizations/RewardStores/RewardStorePrices.cs
new file mode 100644
index 0000000..e65316b
--- /dev/null
+++ b/server/customizations/RewardStores/RewardStorePrices.cs
@@ -0,0 +1,238 @@
+// cc-P760: the reward stores' price table, one file: Configuration/reward-stores.json. Every row of every store (the guild
+// stores, the Festival store and the Achievement store) by its key: its price and what opens it. The prices are
+// placeholders (Chase's plan, section 6) to be tuned in play.
+//
+// Loaded the way cc-P78's recipe-gating.json is: a missing file is written with the built-in defaults (each row's own
+// DefaultPrice and DefaultOpensAt); a file that fails any check is refused whole and the table in force is kept;
+// [RewardStores reload reads it again. A row the file leaves out keeps its default. The test host runs no Configure, so it
+// uses the defaults.
+
+#nullable enable
+
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Text.Json;
+using Server.Commands;
+
+namespace Server.Engines.RewardStores;
+
+public sealed class RewardStorePrices
+{
+    public const string FileName = "reward-stores.json";
+
+    public static string FilePath => Path.Combine(Core.BaseDirectory, "Configuration", FileName);
+
+    public sealed record Entry(int Price, int OpensAt);
+
+    public string Source { get; init; } = "built-in defaults";
+
+    public Dictionary<string, Entry> Rows { get; init; } = new(StringComparer.Ordinal);
+
+    public static RewardStorePrices Defaults { get; } = new();
+
+    public static RewardStorePrices Current { get; set; } = Defaults;
+
+    public int PriceOf(RewardStoreRow row) => Rows.TryGetValue(row.Key, out var e) ? e.Price : row.DefaultPrice;
+
+    public int OpensAtOf(RewardStoreRow row) => Rows.TryGetValue(row.Key, out var e) ? e.OpensAt : row.DefaultOpensAt;
+
+    /// <summary>Every store whose rows the table prices, for the defaults file and the key check.</summary>
+    public static IEnumerable<RewardStoreDef> AllStores()
+    {
+        foreach (var store in GuildStores.All())
+        {
+            yield return store;
+        }
+
+        yield return new FestivalStoreDef(null);
+        yield return new AchievementStoreDef();
+    }
+
+    public static IEnumerable<RewardStoreRow> AllRows() => AllStores().SelectMany(s => s.AllRows());
+
+    public static void Configure()
+    {
+        CommandSystem.Register("RewardStores", AccessLevel.GameMaster, OnCommand);
+
+        EventSink.ServerStarted += () =>
+        {
+            foreach (var line in LoadOrWriteDefaults(FilePath))
+            {
+                Console.WriteLine($"[RewardStores] {line}");
+            }
+        };
+    }
+
+    [Usage("RewardStores [reload | grant <character name> <tokens|ap|renown|guild:<key>> <amount>]")]
+    [Description("The reward stores' price table (cc-P760). With no argument, says where the prices came from. reload reads Configuration/reward-stores.json again (a bad file is refused whole). grant gives a character Festival Tokens, AP, Renown or a guild's points (joining the guild, standing set to the amount), for testing.")]
+    [ShardCommand(CommandCategory.DevTool, Shard = CommandShard.TestFirst)]
+    private static void OnCommand(CommandEventArgs e)
+    {
+        var verb = e.Length > 0 ? e.GetString(0).ToLowerInvariant() : "";
+        var lines = verb switch
+        {
+            "reload" => Reload(FilePath),
+            "grant"  => RewardStoreCommands.Grant(e.Arguments),
+            _ => [$"Reward store prices from {Current.Source}: {Current.Rows.Count} rows in the file, {AllRows().Count()} rows in all. [RewardStores reload reads {FileName} again. [RewardStores grant <character name> <tokens|ap|guild:<key>> <amount> (staff, for testing)."]
+        };
+        foreach (var line in lines)
+        {
+            e.Mobile.SendMessage(line);
+        }
+    }
+
+    // -- The file ---------------------------------------------------------------------------------------------------
+
+    private static readonly JsonSerializerOptions Json = new()
+    {
+        WriteIndented = true,
+        AllowTrailingCommas = true,
+        ReadCommentHandling = JsonCommentHandling.Skip,
+        PropertyNameCaseInsensitive = true
+    };
+
+    private sealed class FileRow
+    {
+        public string? Store { get; set; }
+        public string? Label { get; set; }
+        public int? Price { get; set; }
+        public int? OpensAt { get; set; }
+    }
+
+    private sealed class FileForm
+    {
+        public string? About { get; set; }
+        public Dictionary<string, FileRow>? Rows { get; set; }
+    }
+
+    /// <summary>The defaults as the file: every row of every store, its store and label beside it for the reader.</summary>
+    public static string DefaultsJson()
+    {
+        var rows = new Dictionary<string, FileRow>(StringComparer.Ordinal);
+        foreach (var store in AllStores())
+        {
+            foreach (var row in store.AllRows())
+            {
+                rows[row.Key] = new FileRow
+                {
+                    Store = store.Title,
+                    Label = row.Label,
+                    Price = row.DefaultPrice,
+                    OpensAt = row.DefaultOpensAt
+                };
+            }
+        }
+
+        return JsonSerializer.Serialize(
+            new FileForm
+            {
+                About = "Reward store prices (cc-P760), placeholders to tune in play. One row per store row, by key: price in " +
+                        "the store's currency, and opensAt (a guild row: the rank index 0 Initiate to 5 top rank; an " +
+                        "Achievement row: the AP total; a Festival row: 0). store and label are for reading only. Edit and " +
+                        "run [RewardStores reload; a bad file is refused whole.",
+                Rows = rows
+            },
+            Json
+        );
+    }
+
+    /// <summary>Reads a table. Null and errors when anything is wrong: not JSON, an unknown key, a negative number.</summary>
+    public static RewardStorePrices? Parse(string json, string source, List<string> errors)
+    {
+        FileForm? f;
+        try
+        {
+            f = JsonSerializer.Deserialize<FileForm>(json, Json);
+        }
+        catch (JsonException ex)
+        {
+            errors.Add($"not valid JSON: {ex.Message}");
+            return null;
+        }
+
+        if (f == null)
+        {
+            errors.Add("the file is empty.");
+            return null;
+        }
+
+        var known = AllRows().ToDictionary(r => r.Key, StringComparer.Ordinal);
+        var table = new RewardStorePrices { Source = source };
+
+        foreach (var (key, row) in f.Rows ?? new Dictionary<string, FileRow>())
+        {
+            if (!known.TryGetValue(key, out var def))
+            {
+                errors.Add($"rows.{key}: no store sells a row with this key.");
+                continue;
+            }
+
+            var price = row.Price ?? def.DefaultPrice;
+            var opens = row.OpensAt ?? def.DefaultOpensAt;
+            if (price < 0 || opens < 0)
+            {
+                errors.Add($"rows.{key}: price and opensAt are 0 or more.");
+                continue;
+            }
+
+            table.Rows[key] = new Entry(price, opens);
+        }
+
+        return errors.Count == 0 ? table : null;
+    }
+
+    /// <summary>At start: read the file, or write the defaults to it when it is missing. Returns lines to log.</summary>
+    public static List<string> LoadOrWriteDefaults(string path)
+    {
+        if (!File.Exists(path))
+        {
+            Current = Defaults;
+            try
+            {
+                Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+                File.WriteAllText(path, DefaultsJson());
+                return [$"{FileName} was missing; wrote the built-in defaults to {path}."];
+            }
+            catch (Exception ex)
+            {
+                return [$"{FileName} is missing and could not be written ({ex.Message}); using the built-in defaults."];
+            }
+        }
+
+        return Reload(path);
+    }
+
+    public static List<string> Reload(string path)
+    {
+        string json;
+        try
+        {
+            json = File.ReadAllText(path);
+        }
+        catch (Exception ex)
+        {
+            return [$"Could not read {path} ({ex.Message}); kept {Current.Source}."];
+        }
+
+        return Apply(json, path);
+    }
+
+    /// <summary>Parses and, if it is good, puts the table in force. Returns lines to report.</summary>
+    public static List<string> Apply(string json, string source)
+    {
+        var errors = new List<string>();
+        var table = Parse(json, source, errors);
+
+        if (table == null)
+        {
+            var lines = new List<string> { $"{FileName} REFUSED ({errors.Count} error{(errors.Count == 1 ? "" : "s")}); kept {Current.Source}:" };
+            lines.AddRange(errors.Select(e => $"  {e}"));
+            return lines;
+        }
+
+        Current = table;
+        return [$"Loaded the reward store prices from {source} ({table.Rows.Count} rows)."];
+    }
+}
